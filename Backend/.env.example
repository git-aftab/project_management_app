# Copy this file to .env and replace every placeholder with your own value.
# Never commit the real .env file.
NODE_ENV=development
PORT=3000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
REDIS_URL=redis://127.0.0.1:6379

# Use separate, randomly generated values of at least 32 characters.
ACCESS_TOKEN_SECRET=<generate-a-long-random-secret>
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=<generate-a-different-long-random-secret>
REFRESH_TOKEN_EXPIRY=10d

CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
SERVER_URL=http://localhost:3000

MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=<smtp-username>
MAILTRAP_SMTP_PASS=<smtp-password>
